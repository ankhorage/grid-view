{
  "name": "@ankhorage/grid-view",
  "version": "0.5.0",
  "description": "Platform-neutral grid viewport, axes, snapping and virtualization geometry for Ankhorage.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/grid-view.git"
  },
  "homepage": "https://github.com/ankhorage/grid-view#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/grid-view/issues"
  },
  "keywords": [
    "ankhorage",
    "grid",
    "viewport",
    "virtualization",
    "quantization",
    "react-native",
    "web"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test",
    "prepack": "bun run build",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "docs": "paradox",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@ankhorage/devtools": "^2.2.2",
    "@ankhorage/paradox": "^0.3.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "~6.0.3"
  }
}
